# 智能语音 SaaS 平台 Windows/WSL 部署配置
# 使用方式：
#   cp app.env.example app.env
#   nano app.env

# 项目统一目录。建议放在 WSL 的 Linux 文件系统里，不要直接放 /mnt/c 下运行。
APP_HOME="$HOME/voice.baconboat"

# 目录结构按你当前 Mac 项目整理后的结构来：
#   ~/voice.baconboat/
#   ├── layout-voice-factory/
#   ├── minio-backend/
#   ├── funasr/
#   ├── layout-tts-0.22.0/
#   └── speech_campplus_sv_zh-cn_16k-common/

FRONTEND_DIR="$APP_HOME/layout-voice-factory"
BACKEND_DIR="$APP_HOME/minio-backend/springboot-minio"
FUNASR_DIR="$APP_HOME/funasr/FunASR"
FUNASR_WS_DIR="$FUNASR_DIR/runtime/python/websocket"
VOICEPRINT_DIR="$APP_HOME/speech_campplus_sv_zh-cn_16k-common"
DEPLOY_DIR="$FRONTEND_DIR/deploy"

# Python。推荐迁移后单独创建 venv 或 conda 环境，然后把这里改成真实解释器路径。
PYTHON_BIN="python3"

# 前端构建产物
FRONTEND_DIST="$FRONTEND_DIR/dist"

# 后端打包产物
BACKEND_JAR="$BACKEND_DIR/target/springboot-minio-0.0.1-SNAPSHOT.jar"

# TTS 启动器。注意它会再去引用 layout-tts-0.22.0/layout/simple_tts_backend.py
TTS_LAUNCHER="$DEPLOY_DIR/run_simple_tts_backend.py"

# 数据库配置。要和 Spring Boot application 配置保持一致。
MYSQL_DATABASE="voice_factory"
MYSQL_USER="voice_user"
MYSQL_PASSWORD="12345678"
MYSQL_ROOT_PASSWORD=""
SCHEMA_SQL="$APP_HOME/minio_schema_only.sql"

# MinIO
MINIO_DATA_DIR="$APP_HOME/deploy-runtime-data/minio-data"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# 端口
MYSQL_PORT=3306
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
FUNASR_HTTP_PORT=8002
FUNASR_WS_PORT=10095
TTS_PORT=8003
VOICEPRINT_PORT=8004
BACKEND_PORT=8080
PUBLIC_PORT=8088

# NATAPP 公网访问
NATAPP_ENABLED=true
NATAPP_AUTHTOKEN="516c4d35974b378d"
NATAPP_BIN="/opt/natapp/natapp"
NATAPP_PUBLIC_URL="http://voice.baconboat.cn"
